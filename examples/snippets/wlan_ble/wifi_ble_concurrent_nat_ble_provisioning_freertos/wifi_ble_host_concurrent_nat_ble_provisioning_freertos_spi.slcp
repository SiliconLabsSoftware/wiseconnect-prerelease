project_name: wifi_ble_host_concurrent_nat_ble_provisioning_freertos_spi
package: multi_protocol_siwx91x_app
quality: production
label: Wi-Fi Bluetooth LE - Host Concurrent NAT BLE Provisioning FreeRTOS (SPI)
category: Example|Wi-Fi_BLE
description: 'Demonstrates how to enable concurrent AP+STA with NAT so third-party clients reach the internet using Wi-Fi and Bluetooth LE with an external host connected over SPI.

  '
filter:
- name: Wireless Technology
  value:
  - WiFi BLE
- name: Device Type
  value:
  - Host
- name: Project Difficulty
  value:
  - Intermediate
- name: Quality
  value:
  - Production
source:
- path: app.c
- path: ble_app.c
- path: wifi_app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: ble_config.h
  - path: wifi_config.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: device_init
- id: spidrv
  instance:
  - exp
- id: iostream_retarget_stdio
- id: iostream_recommended_stream
- id: iostream_stdlib_config
- id: wiseconnect_common
- id: ble
- id: wifi
- id: sl_si91x_internal_stack
- id: sl_si91x_spi_bus
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: bsd_socket
- id: sl_si91x_asynchronous_socket
- id: log_none
- id: log_backend_iostream
- id: log_backend_iostream_formatted
- id: log_platform_specific
toolchain_settings:
- option: gcc_linker_option
  value: -u _printf_float
- option: llvm_linker_option
  value: -Wl,-u,_printf_float
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: configUSE_POSIX_ERRNO
  value: '1'
- name: configTOTAL_HEAP_SIZE
  value: '51200'
- name: configTIMER_TASK_PRIORITY
  value: '55'
- name: SL_LOG_CONFIG_LEVEL_COMPILE_TIME
  value: SL_LOG_CONFIG_LEVEL_INFO
readme:
- path: readme.md
other_file:
- path: resources/readme/remote_screen1.png
- path: resources/readme/remote_screen2.png
- path: resources/readme/remote_screen3.png
- path: resources/readme/remote_screen4.png
- path: resources/readme/serial_log1.png
- path: resources/readme/serial_log2.png
- path: resources/readme/serial_log3.png
- path: resources/readme/setup.png
- path: resources/readme/TCP_TX.png
- path: resources/readme/TCP_tx_console.png
- path: resources/readme/UDP_tx_console.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.2.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.12.0
