project_name: wifi_host_user_gain_table_freertos_uart
package: wifi_app
quality: production
label: Wi-Fi - Host User Gain Table FreeRTOS (UART)
category: Example|Wi-Fi
description: 'Demonstrates how to transmit Wi-Fi packets at varying rates and power with user gain tables using Wi-Fi with an external host connected over UART.

  '
filter:
- name: Wireless Technology
  value:
  - Wi-Fi
- name: Device Type
  value:
  - Host
- name: Project Difficulty
  value:
  - Beginner
- name: Quality
  value:
  - Production
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: device_init
- id: iostream_retarget_stdio
- id: iostream_rtt
- id: iostream_stdlib_config
- id: uartdrv_usart
  instance:
  - exp
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_internal_stack
- id: sl_si91x_uart_bus
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: log_none
- id: log_backend_iostream
- id: log_backend_iostream_formatted
- id: log_platform_specific
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: configUSE_POSIX_ERRNO
  value: '1'
- name: configTOTAL_HEAP_SIZE
  value: '51200'
- name: configTIMER_TASK_PRIORITY
  value: '55'
- name: SL_LOG_CONFIG_LEVEL_COMPILE_TIME
  value: SL_LOG_CONFIG_LEVEL_INFO
readme:
- path: readme.md
other_file:
- path: resources/readme/application_prints_soc_ncp.png
- path: resources/readme/burst_mode_spectrum_analyser.png
- path: resources/readme/user_gain_table_soc_ncp.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.2.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.12.0
