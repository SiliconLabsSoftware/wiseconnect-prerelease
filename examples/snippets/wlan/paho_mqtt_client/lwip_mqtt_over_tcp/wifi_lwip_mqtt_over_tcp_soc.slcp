project_name: wifi_lwip_mqtt_over_tcp_soc
package: wifi_app
quality: production
label: Wi-Fi - Paho LwIP MQTT OVER TCP (SoC)
category: Example|Wi-Fi
description: 'Demonstrates how SiWx91x device is configured as an MQTT client over
  TCP, connects to an MQTT broker, subscribes to a topic, and publishes messages on
  a particular MQTT topic using the Paho MQTT library with lwip support

  '
filter:
- name: Wireless Technology
  value:
  - Wi-Fi
- name: Project Difficulty
  value:
  - Beginner
sdk:
  id: simplicity_sdk
  version: 2025.12.0
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: sl_si91x_mem_pool_buffers_with_quota
- id: syscalls
- id: si91x_mem_config_3
- id: wiseconnect_common
- id: wifi
- id: mbedtls
- id: sl_si91x_lwip_stack
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: paho_mqtt_embedded
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
readme:
- path: readme.md
other_file:
- path: resources/readme/mqtt_add_topic_name.png
- path: resources/readme/mqtt_server.png
- path: resources/readme/mqtt_application_prints_soc.png
- path: resources/readme/mqtt_application_prints_ssl_soc.png
- path: resources/readme/mqtt_application_prints_ncp.png
- path: resources/readme/mqtt_application_prints_ssl_ncp.png
- path: resources/readme/mqtt_connect.png
- path: resources/readme/mqtt_connect_subscribe.png
- path: resources/readme/mqtt_disconnect_from_explorer.png
- path: resources/readme/mqtt_delete_connections.png
- path: resources/readme/mqtt_explorer_add_cacert1.png
- path: resources/readme/mqtt_explorer_add_cacert2.png
- path: resources/readme/mqtt_explorer_add_cacert3.png
- path: resources/readme/mqtt_explorer_msg.png
- path: resources/readme/mqtt_publish_msg_from_explorer.png
- path: resources/readme/setup_soc_ncp.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
post_build:
  profile: wiseconnect_soc
