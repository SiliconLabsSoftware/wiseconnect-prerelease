project_name: wifi_lwip_soc_empty
package: wifi_app
quality: production
label: Wi-Fi - SoC Empty (lwIP)
category: Example|Wi-Fi
description: 'Minimal Wi-Fi SoC Empty FreeRTOS template using the lwIP stack:

  initialize and connect as a station. No board pinouts. No TCP demo.

  '
filter:
- name: Wireless Technology
  value:
  - Wi-Fi
- name: Device Type
  value:
  - SoC
- name: Project Difficulty
  value:
  - Beginner
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
component:
- id: sl_main
- id: freertos
- id: freertos_heap_3
- id: memory_manager
- id: syscalls
- id: si91x_memory_default_config
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_lwip_stack
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: log_none
- id: si91x_log
- id: si91x_log_iostream_formatted
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
configuration:
- name: SL_LOG_CONFIG_LEVEL_COMPILE_TIME
  value: SL_LOG_CONFIG_LEVEL_INFO
readme:
- path: readme.md
ui_hints:
  highlight:
  - path: readme.md
    focus: true
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.2.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.12.0
