project_name: siwx91x_bluetooth_le_soc_power_save_freertos
package: bluetooth_le_siwx91x_app
quality: production
label: SiWx91x Bluetooth LE - SoC Power Save FreeRTOS
category: Example|BLE
description: 'Demonstrates how to configure power save modes for a device using SiWx91x Bluetooth LE. This is demonstrated by configuring advertising, scanning, and connected roles in power save modes.

  '
filter:
- name: Wireless Technology
  value:
  - BLE
- name: Device Type
  value:
  - SoC
- name: Project Difficulty
  value:
  - Beginner
- name: Quality
  value:
  - Production
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: ble_config.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
component:
- id: sl_main
- id: freertos
- id: freertos_heap_3
- id: memory_manager
- id: syscalls
- id: si91x_memory_default_config
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_internal_stack
- id: sl_power_manager
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: ble
- id: wireless_wakeup_ulp_component
- id: log_none
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
requires:
- name: device_needs_ram_execution
  condition:
  - si91x_common_flash
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: SL_LOG_CONFIG_LEVEL_COMPILE_TIME
  value: SL_LOG_CONFIG_LEVEL_INFO
readme:
- path: readme.md
other_file:
- path: resources/readme/ble_power_save_soc_ncp.png
- path: resources/readme/blepowersavencpmeasurement.png
- path: resources/readme/blepowersaveadvertising.png
- path: resources/readme/blepowersavedeviceconnection.png
- path: resources/readme/blepwlog.png
- path: resources/readme/output1.png
- path: resources/readme/blepowersavecurrentmeasurementpins.png
- path: resources/readme/blepowersavencpmeasurement.png
- path: resources/readme/blepwsocadv.png
- path: resources/readme/ble_power_save_conn_soc.png
- path: resources/readme/ble_ps_conn_adv_ncp.png
- path: resources/readme/ble_ps_conn_adv_psram.png
- path: resources/readme/ble_ps_conn_adv_soc.png
- path: resources/readme/ble_ps_conn_soc.png
- path: resources/readme/output2.png
- path: resources/readme/blepowersavedeviceconnection1.png
- path: resources/readme/blepowersavedeviceconnection2.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.2.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.12.0
