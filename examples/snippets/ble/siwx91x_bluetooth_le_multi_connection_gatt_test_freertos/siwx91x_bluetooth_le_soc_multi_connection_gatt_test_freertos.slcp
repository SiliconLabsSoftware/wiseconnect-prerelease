project_name: siwx91x_bluetooth_le_soc_multi_connection_gatt_test_freertos
package: bluetooth_le_siwx91x_app
quality: production
label: SiWx91x Bluetooth LE - SoC Multi-connection GATT Test FreeRTOS
category: Example|BLE
description: 'Demonstrates how to perform GATT testing with multiple simultaneous links between central and peripheral devices, using SiWx91x Bluetooth LE.

  '
filter:
- name: Wireless Technology
  value:
  - BLE
- name: Device Type
  value:
  - SoC
- name: Project Difficulty
  value:
  - Advanced
- name: Quality
  value:
  - Production
source:
- path: ble_device_info.c
- path: ble_main_task.c
- path: ble_subtasks.c
- path: app.c
include:
- path: .
  file_list:
  - path: ble_device_info.h
  - path: app.h
  - path: ble_config.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: syscalls
- id: si91x_memory_default_config
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_internal_stack
- id: sl_power_manager
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: ble
- id: wireless_wakeup_ulp_component
- id: log_none
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
requires:
- name: device_needs_ram_execution
  condition:
  - si91x_common_flash
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: SL_LOG_CONFIG_LEVEL_COMPILE_TIME
  value: SL_LOG_CONFIG_LEVEL_INFO
readme:
- path: readme.md
other_file:
- path: resources/readme/blemultigatt_soc_ncp.png
- path: resources/readme/output_1.png
- path: resources/readme/output_2.png
- path: resources/readme/output_3.png
- path: resources/readme/output_4.png
- path: resources/readme/central_connected.png
- path: resources/readme/central_scan.png
- path: resources/readme/output_5.png
- path: resources/readme/peripheral_connected.png
- path: resources/readme/peripheral.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.2.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.12.0
