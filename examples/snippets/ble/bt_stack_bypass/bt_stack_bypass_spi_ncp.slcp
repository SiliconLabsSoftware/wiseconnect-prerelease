project_name: bt_stack_bypass_spi_ncp
package: bluetooth_le_siwx91x_app
quality: production
label: BLE - NCP BT Stack Bypass
category: Example|BLE
description: 'BLE HCI raw (stack bypass) on NCP host MCU (EFR32 + Si91x module) over SPI.

  Open this .slcp in Simplicity Studio to generate CMake/autogen for the host target.

  Application source: app.c (NCP path when SLI_SI91X_MCU_INTERFACE is not defined).

  NCP host bus matches wireless_test_ncp: sl_si91x_spi_bus + spidrv (EXP header); HCI to host PC uses VCOM/iostream (recommended stream), not the SPI link.

  '
filter:
- name: Wireless Technology
  value:
  - BLE
- name: Device Type
  value:
  - NCP
- name: Project Difficulty
  value:
  - Beginner
- name: Quality
  value:
  - Production
source:
- path: app.c
- path: utils/command_parser.c
- path: utils/event_loop.c
- path: utils/rsi_common_utils.c
- path: btdm_logging_framework/debug_logs_event_hdlr_auto_gen.c
- path: btdm_logging_framework/debug_logs_task.c
- path: btdm_logging_framework/debug_logs_user_event_hdlrs.c
include:
- path: .
  file_list:
  - path: app.h
  - path: ble_config.h
  - path: app_rtt_logging.h
- path: utils
  file_list:
  - path: generic_command_handling.h
  - path: rsi_common_utils.h
  - path: event_loop.h
- path: btdm_logging_framework
  file_list:
  - path: debug_logs_event_hdlr_auto_gen.h
define:
- name: SLI_SI91X_MCU_INTR_BASED_RX_ON_UART
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: device_init
- id: spidrv
  instance:
  - exp
- id: iostream_retarget_stdio
- id: iostream_recommended_stream
- id: iostream_stdlib_config
- id: segger_rtt
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_internal_stack
- id: wifi_resources
- id: sl_si91x_spi_bus
- id: network_manager
- id: basic_network_config_manager
- id: ble
- id: iot_socket
- id: log_none
- id: log_backend_iostream
- id: log_backend_iostream_formatted
- id: log_platform_specific
toolchain_settings:
- value: -Wall -Werror
  option: gcc_compiler_option
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: configUSE_POSIX_ERRNO
  value: '1'
- name: configTOTAL_HEAP_SIZE
  value: '51200'
- name: configTIMER_TASK_PRIORITY
  value: '55'
- name: NVM3_DEFAULT_MAX_OBJECT_SIZE
  value: '280'
readme:
- path: readme.md
other_file:
- path: resources/readme/blenewappsoc.png
- path: resources/readme/consoleprints.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.0
