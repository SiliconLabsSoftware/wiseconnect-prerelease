project_name: siwx91x_platform_mutex_freertos
package: platform_siwx91x_app
description: 'This example project demonstrates a CMSIS-RTOS mutex on the SiWx91x SoC. Two FreeRTOS

  threads share one LED and take the mutex before toggling it.

  '
category: example|cmsis-rtos
quality: production
label: SiWx91x Platform - Mutex FreeRTOS
component:
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: freertos
- id: freertos_heap_3
- id: memory_manager
- id: sleeptimer
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_retarget_stdio
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_si91x_led_917
  instance:
  - led0
source:
- path: app.c
- path: src/blinky.c
include:
- path: .
  file_list:
  - path: app.h
- path: src/inc
  file_list:
  - path: blinky.h
define:
- name: SYSCALLS_WRITE
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/setupdiagram.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.2.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.12.0
