project_name: siwx91x_platform_wdt_manager
package: platform_siwx91x_app
description: 'This example project demonstrates the watchdog manager on the SiWx91x SoC. An LED

  blinks ten times, then the application hangs so the watchdog can reset the device.

  '
category: example|service
quality: production
label: SiWx91x Platform - WDT Manager
component:
- id: sl_main
- id: sleeptimer
- id: sl_si91x_led_917
  instance:
  - led0
- id: sl_wdt_manager
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_retarget_stdio
- id: iostream_uart_si91x
  instance:
  - vcom
source:
- path: app.c
- path: wdt_manager.c
include:
- path: .
  file_list:
  - path: app.h
  - path: wdt_manager.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/setupdiagram.png
define:
- name: SYSCALLS_WRITE
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.2.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.12.0
