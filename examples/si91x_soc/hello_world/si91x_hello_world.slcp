project_name: si91x_hello_world
package: platform_siwx91x_app
description: "This application demonstrates how to use hello world example that can be used as a starting point \nto add components and functionality to the SiWx91x SoC.\n"
category: Example|si91x_soc
quality: production
label: Platform SiWx91x - Hello World
component:
- id: sl_main
- id: syscalls
- id: si91x_memory_default_config
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/outputConsole.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.0
