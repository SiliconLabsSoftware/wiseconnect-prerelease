project_name: siwx91x_platform_psa_gcm_large_data_freertos
package: platform_siwx91x_app
description: 'This example project demonstrates multipart AES-GCM on the SiWx91x SoC, encrypting and

  decrypting a large buffer in smaller chunks with the PSA Crypto API.

  '
category: example|crypto
quality: production
label: SiWx91x Platform - PSA GCM Large Data FreeRTOS
component:
- id: sl_main
- id: freertos
- id: freertos_heap_3
- id: memory_manager
- id: psa_crypto
- id: psa_driver
- id: psa_crypto_gcm
- id: psa_crypto_trng
- id: syscalls
- id: si91x_memory_default_config
- id: wifi
- id: sl_si91x_internal_stack
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
source:
- path: app.c
- path: psa_gcm_app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: psa_gcm_app.h
define:
- name: SL_MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS
  value: 1
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/image508a.png
- path: resources/readme/gcm_output.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
post_build:
  profile: wiseconnect_soc
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.2.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.12.0
