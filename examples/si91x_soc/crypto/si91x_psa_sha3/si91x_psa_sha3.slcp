project_name: si91x_psa_sha3
package: platform_siwx91x_app
description: 'This example project demonstrates the PSA3 SHA API in SI91x.

  '
category: example|crypto
quality: production
label: SiWx91x Platform - PSA SHA3
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: psa_crypto
- id: psa_driver
- id: psa_crypto_trng
- id: sl_si91x_sha3
- id: sl_si91x_psa_sha3
- id: syscalls
- id: si91x_memory_default_config
- id: wifi
- id: sl_si91x_internal_stack
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
source:
- path: psa_sha3_app.c
- path: app.c
include:
- path: .
  file_list:
  - path: psa_sha3_app.h
  - path: app.h
define:
- name: PSA_WANT_ALG_SHA3_224
- name: PSA_WANT_ALG_SHA3_256
- name: PSA_WANT_ALG_SHA3_384
- name: PSA_WANT_ALG_SHA3_512
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/image508a.png
- path: resources/readme/output.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
post_build:
  profile: wiseconnect_soc
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.2.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.12.0
