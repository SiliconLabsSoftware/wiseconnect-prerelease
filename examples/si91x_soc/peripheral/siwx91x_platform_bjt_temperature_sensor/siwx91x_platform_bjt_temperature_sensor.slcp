project_name: siwx91x_platform_bjt_temperature_sensor
package: platform_siwx91x_app
description: 'This example project demonstrates the on-chip BJT temperature sensor on the SiWx91x

  SoC, using the ADC and OPAMP to report die temperature from -40 C to +125 C.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - BJT Temperature Sensor
component:
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_retarget_stdio
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_bjt_temperature_sensor
- id: sl_adc
- id: adc_instance
  instance:
  - channel_1
source:
- path: bjt_temperature_sensor_example.c
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: bjt_temperature_sensor_example.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
define:
- name: GAIN_OFFSET_CAL_EN
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/output.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.2.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.12.0
