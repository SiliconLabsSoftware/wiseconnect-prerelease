project_name: siwx91x_platform_uart_rs485_freertos
package: platform_siwx91x_app
description: 'This example project demonstrates UART RS485 multidrop operation on the SiWx91x SoC

  under FreeRTOS, including hardware- and software-controlled half duplex and 9-bit

  addressing.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - UART RS485 FreeRTOS
component:
- id: freertos_heap_3
- id: memory_manager
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_retarget_stdio
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_clock_manager
- id: sl_gpio
- id: rsilib_usart_rs485
- id: sl_uart1_rs485
source:
- path: uart_rs485_mode_freertos.c
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: uart_rs485_mode_freertos.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
define:
- name: SLI_SI91X_MCU_CONFIG_RADIO_BOARD_BASE_VER
- name: SLI_SI91X_MCU_RS485_MODE
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/3_board_setup.png
- path: resources/readme/N_board_setup.png
- path: resources/readme/uart1_rs485_output_console.png
- path: resources/uc_screen/uart0_rs485_hardware_controlled_half_duplex_receive_mode_uc.png
- path: resources/uc_screen/uart0_rs485_hardware_controlled_half_duplex_transmit_mode_uc.png
- path: resources/uc_screen/uart0_rs485_software_controlled_half_duplex_uc.png
- path: resources/uc_screen/uart1_rs485_hardware_controlled_half_duplex_receive_mode_uc.png
- path: resources/uc_screen/uart1_rs485_hardware_controlled_half_duplex_transmit_mode_uc.png
- path: resources/uc_screen/uart1_rs485_software_controlled_half_duplex_uc.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.2.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.12.0
