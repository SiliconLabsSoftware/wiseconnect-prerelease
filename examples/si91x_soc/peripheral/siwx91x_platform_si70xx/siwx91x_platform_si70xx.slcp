project_name: siwx91x_platform_si70xx
package: platform_siwx91x_app
description: 'This example project demonstrates the Si70xx relative-humidity and temperature sensor

  on the SiWx91x SoC over I2C, printing a measurement every 2 seconds.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - Si70xx
component:
- id: sl_main
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_retarget_stdio
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_si70xx
- id: sl_i2c
- id: sl_dma
- id: sleeptimer
- id: i2c_instance
  instance:
  - i2c2
source:
- path: app.c
- path: si70xx_example.c
include:
- path: .
  file_list:
  - path: app.h
  - path: si70xx_example.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/output1.png
- path: resources/readme/output2.png
- path: resources/uc_screen/si70xx_uc_screen.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.2.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.12.0
