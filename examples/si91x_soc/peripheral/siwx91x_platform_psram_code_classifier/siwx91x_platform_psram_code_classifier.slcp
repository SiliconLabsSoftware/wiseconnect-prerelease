project_name: siwx91x_platform_psram_code_classifier
package: platform_siwx91x_app
description: 'This example project demonstrates the PSRAM code classifier on the SiWx91x SoC,

  placing selected variables in PSRAM or SRAM.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - PSRAM Code Classifier
component:
- id: sl_main
- id: sleeptimer
- id: data_segment_in_psram
- id: text_segment_in_psram
- id: psram_core
- id: syscalls
- id: si91x_memory_default_config
- id: sl_si91x_code_classifier
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_retarget_stdio
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_si91x_led_917
  instance:
  - led0
source:
- path: app.c
- path: code_classifier.c
include:
- path: .
  file_list:
  - path: app.h
  - path: code_classifier.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/setupdiagram.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.2.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.12.0
