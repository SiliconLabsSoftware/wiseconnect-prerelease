upgrade:
  - sdk:
      id: wiseconnect3_sdk
      version: "3.5.0"
    component:
      - trigger: debug_ulp_component
        description: >
                                
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: comparator_ulp_component
        description: >
                   
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: dac_ulp_component
        description: >
                  
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: timer_ulp_component
        description: >
                   
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: calender_ulp_component
        description: >
                   
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: bod_ulp_component
        description: >
                      
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: adc_ulp_component
        description: >
                       
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: cts_ulp_component
        description: >
                      
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: dma_ulp_component
        description: >
                          
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: gpio_npss_component
        description: >
                                
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: gpio_ulp_component
        description: >
                               
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: i2c_ulp_component
        description: >
                             
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: i2s_ulp_component
        description: >
                             
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: wdt_ulp_component
        description: >
                               
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: usart_ulp_component
        description: >
                                    
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: sysrtc_ulp_component
        description: >
                                
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: user_files
        description: >
                                   
        status: automatic  
        add:
           - pm_ps2_component
      - trigger: ssi_ulp_component
        description: >
                                 
        status: automatic  
        add:
           - pm_ps2_component
      - script: upgrade_script.lua
        description: >
                          
  - sdk:
      id: wiseconnect3_sdk
      version: "4.0.0"
    component:
      - trigger: wiseconnect3_common
        description: >
                                
        status: automatic  
        add:
           - wiseconnect_common
        remove:
           - wiseconnect3_common
      - trigger: wiseconnect3_logger
        description: >
                                
        status: automatic  
        add:
           - wiseconnect_logger
        remove:
           - wiseconnect3_logger
      - trigger: sl_si91x_littlefs_common_flash
        description: >
                      Adding freertos_heap_4 component          
        status: automatic  
        add:
           - sl_si91x_freertos_heap4_for_littlefs
      - script: upgrade_wireless_component_for_common_flash.lua
        description: >
          Restore wireless components for common-flash NVM3 and LittleFS.
  - sdk:
      id: wiseconnect3_sdk
      vendor: silabs
      version: "4.1.2"
    component:
      - trigger: psram_aps6404l_sqh
        description: >
                                
        status: automatic  
        remove:
           - psram_aps6404l_sqh
      - trigger: sl_si91x_basic_buffers
        description: >
          The 'Basic Buffer Manager' component is deprecated with a deprecation period of 18 months. 
          Its replacement, 'Buffer Manager', is pulled in automatically 
          when you select the 'Wi-Fi' component.
        status: automatic
      - trigger: sl_si91x_mem_pool_buffers
        description: >
          The 'Memory Pool Buffer' component is deprecated with a deprecation period of 18 months. 
          Its replacement, 'Buffer Manager', is pulled in automatically 
          when you select the 'Wi-Fi' component.
        status: automatic
      - trigger: sl_si91x_mem_pool_buffers_with_quota
        description: >
          The 'Memory Pool Buffer With Quota' component is deprecated with a deprecation period of 18 months. 
          Its replacement, 'Buffer Manager', is pulled in automatically 
          when you select the 'Wi-Fi' component.
        status: automatic
      - script: upgrade_wiseconnect_ctm.lua
        description: >
          Migrate nvm3_network_config_manager and nvm3_credential_manager to flash (CTM) variants.
  - sdk:
      id: wiseconnect3_sdk
      vendor: silabs
      version: "4.2.0"
    component:
      - trigger: sl_si91x_littlefs_common_flash
        description: >
          Restore wireless components for common-flash LittleFS.
        status: automatic
        add:
          - wifi
          - sl_si91x_wireless
          - network_manager
          - basic_network_config_manager
          - wifi_resources
      - trigger: sl_si91x_fw_fallback
        description: >
          Preserve the internal network stack for firmware-fallback applications.
        status: automatic
        add:
          - sl_si91x_internal_stack
      - script: upgrade_wireless_component_for_common_flash.lua
        description: >
          Restore wireless components removed from common-flash NVM3 and LittleFS.
      - trigger: sl_si91x_asynchronous_socket
        description: >
          'Asynchronous Socket' moved from the WiSeConnect wifi package into
          Simplicity SDK network_stack_sdk. The selection is re-pointed at the
          Simplicity SDK package.
        status: automatic
        remove:
          - sl_si91x_asynchronous_socket
        add:
          - id: sl_si91x_asynchronous_socket
            package: simplicity_sdk
            vendor: silabs
      - trigger: sl_si91x_socket
        description: >
          'Socket' moved from the WiSeConnect wifi package into Simplicity SDK
          network_stack_sdk. The selection is re-pointed at the Simplicity SDK
          package.
        status: automatic
        remove:
          - sl_si91x_socket
        add:
          - id: sl_si91x_socket
            package: simplicity_sdk
            vendor: silabs
      - trigger: bsd_socket
        description: >
          'BSD Socket' moved from the WiSeConnect wifi package into Simplicity
          SDK network_stack_sdk. The selection is re-pointed at the Simplicity
          SDK package.
        status: automatic
        remove:
          - bsd_socket
        add:
          - id: bsd_socket
            package: simplicity_sdk
            vendor: silabs
      - trigger: bsd_socket_api
        description: >
          'BSD Socket API' moved from the WiSeConnect wifi package into
          Simplicity SDK network_stack_sdk. The selection is re-pointed at the
          Simplicity SDK package.
        status: automatic
        remove:
          - bsd_socket_api
        add:
          - id: bsd_socket_api
            package: simplicity_sdk
            vendor: silabs
      - trigger: sl_websocket_client
        description: >
          'Websocket Client' moved from the WiSeConnect wifi package into
          Simplicity SDK network_stack_sdk. The selection is re-pointed at the
          Simplicity SDK package.
        status: automatic
        remove:
          - sl_websocket_client
        add:
          - id: sl_websocket_client
            package: simplicity_sdk
            vendor: silabs
      - trigger: paho_mqtt_embedded
        description: >
          'paho_mqtt_embedded' moved from the WiSeConnect wifi package into
          Simplicity SDK network_stack. The selection is re-pointed at the
          Simplicity SDK package.
        status: automatic
        remove:
          - paho_mqtt_embedded
        add:
          - id: paho_mqtt_embedded
            package: simplicity_sdk
            vendor: silabs
      - trigger: paho_mqtt_embedded_dual_stack
        description: >
          'paho_mqtt_embedded_dual_stack' moved from the WiSeConnect wifi package
          into Simplicity SDK network_stack. The selection is re-pointed at the
          Simplicity SDK package.
        status: automatic
        remove:
          - paho_mqtt_embedded_dual_stack
        add:
          - id: paho_mqtt_embedded_dual_stack
            package: simplicity_sdk
            vendor: silabs
