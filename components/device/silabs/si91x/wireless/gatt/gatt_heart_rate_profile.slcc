id: gatt_heart_rate_profile
label: GATT Heart Rate Profile
description: >
  Heart Rate profile component with server registration hook for Service 0x180D
  and optional client notification decoding (legacy BPM print format) when
  GATT client is enabled.
category: Device|Si91x|Wireless|BLE|GATT|PROFILES
quality: production
metadata:
  sbom:
    license: Zlib
package: bluetooth_le_siwx91x
component_root_path: ./components/device/silabs/si91x/wireless/gatt
requires:
  - name: gatt_server
provides:
  - name: gatt_heart_rate_profile_registration
source:
  - path: profiles/heart_rate/src/gatt_heart_rate_server.c
  - path: profiles/heart_rate/src/gatt_heart_rate_client.c
include:
  - path: profiles/heart_rate/inc
    file_list:
      - path: gatt_heart_rate_server.h
