      <memberdef kind="function" id="group__CRYPTO__CCM__FUNCTIONS_1gaeec2df70d12c119f46e0dd662bd40c35" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>sl_status_t</type>
        <definition>sl_status_t sl_si91x_mp_ccm_init</definition>
        <argsstring>(sl_si91x_ccm_config_t *config)</argsstring>
        <name>sl_si91x_mp_ccm_init</name>
        <param>
          <type><ref refid="structsl__si91x__ccm__config__t" kindref="compound">sl_si91x_ccm_config_t</ref> *</type>
          <declname>config</declname>
        </param>
        <briefdescription>
<para>To initialize a multipart CCM operation by sending the first-packet command (FIRST_CHUNK) to the firmware. </para>
        </briefdescription>
        <detaileddescription>
<para>This resets and initializes the firmware CCM context with all required configuration: key, nonce, AD, tag length, total message length, and encrypt/decrypt direction. No plaintext or ciphertext payload is sent in this call. This is a blocking API. <parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">config</parametername>
</parameternamelist>
<parameterdescription>
<para>Configuration object of type <ref refid="structsl__si91x__ccm__config__t" kindref="compound">sl_si91x_ccm_config_t</ref>. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>sl_status_t. For more information on status codes, refer to <ulink url="https://docs.silabs.com/gecko-platform/latest/platform-common/status">SL STATUS DOCUMENTATION</ulink>. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
