      <memberdef kind="function" id="group__CRYPTO__CCM__FUNCTIONS_1gaaf26bcae80248c395d72dec4c9b7b5a3" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>sl_status_t</type>
        <definition>sl_status_t sl_si91x_mp_ccm_update</definition>
        <argsstring>(sl_si91x_ccm_config_t *config, uint16_t chunk_length, uint8_t *output)</argsstring>
        <name>sl_si91x_mp_ccm_update</name>
        <param>
          <type><ref refid="structsl__si91x__ccm__config__t" kindref="compound">sl_si91x_ccm_config_t</ref> *</type>
          <declname>config</declname>
        </param>
        <param>
          <type>uint16_t</type>
          <declname>chunk_length</declname>
        </param>
        <param>
          <type>uint8_t *</type>
          <declname>output</declname>
        </param>
        <briefdescription>
<para>To send a middle-packet CCM command (MIDDLE_CHUNK) carrying a chunk of message data to the firmware for encryption or decryption. </para>
        </briefdescription>
        <detaileddescription>
<para>This is a blocking API. <parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">config</parametername>
</parameternamelist>
<parameterdescription>
<para>Configuration object of type <ref refid="structsl__si91x__ccm__config__t" kindref="compound">sl_si91x_ccm_config_t</ref>. The msg pointer should be advanced to the current chunk. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">chunk_length</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of bytes in this chunk. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">output</parametername>
</parameternamelist>
<parameterdescription>
<para>Buffer to store the encrypted or decrypted output for this chunk. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>sl_status_t. For more information on status codes, refer to <ulink url="https://docs.silabs.com/gecko-platform/latest/platform-common/status">SL STATUS DOCUMENTATION</ulink>. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
