id: sl_si91x_agents_md
label: AGENTS.md (Generative AI project context)
package: platform_siwx91x
description: >
  Provides baseline AGENTS.md at project root and generates autogen/AGENTS-SLAB.md
  for AI-enabled IDEs (e.g. Cursor). Per IOTREQ-12094.
category: Services|Generative AI
quality: production
metadata:
  sbom:
    license: MSLA
root_path: components/device/silabs/si91x/sl_si91x_generative_ai/component
ui_hints:
  visibility: never

provides:
  - name: sl_si91x_agents_md

other_file:
  - path: AGENTS.md
    project:
      transfer_ownership: true

template_file:
  - path: template/AGENTS-SLAB.md.jinja

template_contribution:
  - name: agents_slab
    value:
      id: agents_slab
      context: This template is generated by the AGENTS.md component.
      priority: -9000

