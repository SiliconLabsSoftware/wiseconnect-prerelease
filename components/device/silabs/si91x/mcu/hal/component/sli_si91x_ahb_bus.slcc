id: sli_si91x_ahb_bus
package: platform_siwx91x
label: SiWx91x SOC AHB Bus
description: >
  SOC AHB bus APIs (init, read/write frame, interrupt status, submit RX,
  DMA descriptor config/update, raise pkt pending / ta_events)
category: Device|Si91x|MCU|HAL
quality: production
metadata:
  sbom:
    license: Zlib
component_root_path: "components/device/silabs/si91x/mcu/hal"
ui_hints:
  visibility: never
provides:
  - name: sli_si91x_ahb_bus
source:
  - path: src/sli_si91x_ahb_bus.c
include:
  - path: inc
    file_list:
      - path: sli_si91x_ahb_bus.h
requires:
  - name: wiseconnect_common
  - name: sli_queue_manager
  - name: sli_buffer_manager
  - name: sli_si91x_mcu_interface
