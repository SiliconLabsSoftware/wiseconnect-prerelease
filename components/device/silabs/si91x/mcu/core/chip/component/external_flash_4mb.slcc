id: external_flash_4mb
label: 4MB Flash (External)
package: platform_siwx91x
description: >
  Select this component when the SiWx91x board uses 4 MB of external flash.
  In common-flash mode the M4 linker region starts at 0x08202000 and ends at
  0x08400000 (usable size 0x001FE000). Board SLCC may override these defaults.
category: Device|Si91x|MCU|Flash
quality: production
provides:
  - name: external_flash_4mb
  - name: external_flash_implementation

template_contribution:
  - name: flash_present
    value: 1
  - name: device_flash_addr
    value: 135733248 # 0x0817 2000
    priority: -1
  - name: device_flash_size
    value: 1110016 # 0x0010 F000 (~1084 KB M4 image)
    priority: -1
  - name: max_flash_size
    value: 1110016 # 0x0010 F000
    priority: -1
  - name: device_flash_page_size
    value: 256

metadata:
  sbom:
    license: Zlib

documentation:
  url: https://docs.silabs.com/wiseconnect/latest/wifi-siwx917-soc-memory-map/flash-memory
