id: syscalls
package: platform_siwx91x
description: >
  This component provides system calls support for the SiWx91x.
label: System Calls
category: Device|Si91x|MCU|Common
quality: production
metadata:
  sbom:
    license: MSLA
component_root_path: "components/device/silabs/si91x/mcu/core/common"
source:
  - path: "src/syscalls.c"
    unless: [iostream_retarget_stdio, test_framework_unity_gcov]
include:
  - path: inc
    file_list:
      - path: syscalls.h
        unless: [iostream_retarget_stdio, test_framework_unity_gcov]
provides:
  - name: syscalls
  - name: sl_syscalls
    condition: [device_si91x]
requires:
  - name: si91x_debug
  - name: sl_common
