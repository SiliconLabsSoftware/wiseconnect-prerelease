id: sl_si91x_uart_bus
package: platform_siwx91x
description: >
  SiWx91x NCP UART bus interface (init, read/write frame, interrupt status, and
  nested UART helpers).
label: SiWx91x NCP UART bus interface
category: Device|Si91x|Host Interface
quality: production
metadata:
  sbom:
    license: Zlib
component_root_path: components/device/silabs/si91x/host_interface/ncp_bus/uart
provides:
  - name: sl_si91x_uart_bus
source:
  - path: sl_si91x_uart.c
include:
  - path: ../../../wireless/inc
  - path: ../../../wireless/sli_hal_si91x/inc
define:
  - name: SL_NCP_UART_INTERFACE
  - name: SL_NCP_UART_INTERFACE
    value: 1
requires:
  - name: wiseconnect_common
  - name: sli_buffer_manager
  - name: sli_queue_manager
  - name: sl_si91x_host_control
  - condition: ["device_efx"]
    name: sli_si91x_ncp_uart_config
