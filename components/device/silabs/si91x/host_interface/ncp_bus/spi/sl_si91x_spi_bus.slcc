id: sl_si91x_spi_bus
package: platform_siwx91x
description: 'SiWx91x NCP SPI bus interface (init, read/write frame, interrupt status,
  and nested SPI protocol helpers).

  '
label: SiWx91x NCP SPI bus interface
category: Device|Si91x|Host Interface
quality: production
metadata:
  sbom:
    license: Zlib
component_root_path: components/device/silabs/si91x/host_interface/ncp_bus/spi
provides:
- name: sl_si91x_spi_bus
source:
- path: sl_si91x_spi.c
include:
- path: ../../../wireless/inc
- path: ../../../mcu/hal/sli_hal_si91x/inc
requires:
- name: wiseconnect_common
- name: sli_buffer_manager
- name: sl_si91x_host_control
- condition:
  - device_efx
  name: sli_si91x_ncp_spi_config
recommends:
- condition:
  - device_efx
  id: spidrv
  instance:
  - exp
  vendor: silabs
