id: sl_si91x_host_control
package: platform_siwx91x
label: SiWx91x Host Control
description: >
  SiWx91x host control hooks for power cycle, reset, and NCP wakeup.
category: Device|Si91x|Host Interface
quality: production
metadata:
  sbom:
    license: Zlib
component_root_path: components/device/silabs/si91x/host_interface
provides:
  - name: sl_si91x_host_control
source:
  - path: src/sl_si91x_host_control.c
include:
  - path: inc
    file_list:
      - path: sl_si91x_host_control.h
requires:
  - name: wiseconnect_common
  - condition: [device_si91x]
    name: sl_si91x_mcu
  - condition: [device_efx]
    name: efx32_si91x_wireless_connector
