id: flash_credential_manager
package: wifi
description: >
  Flash Credential Manager provides an API to manage credentials stored via Common Token Manager
label: Flash Credential Manager
category: Service|Credential Management|Configuration
quality: production
metadata:
  sbom:
    license: MSLA
component_root_path: ./components/protocol/wifi
provides:
- name: flash_credential_manager
- name: credential_manager
include:
- path: inc
  file_list:
    - path: sl_wifi_credentials.h
source:
- path: src/sl_wifi_nvm_credentials.c
  condition: ["sl_si91x_wireless"]
requires:
- name: wifi
- name: nvm3_lib
  condition: ["sl_si91x_wireless"]
conflicts:
  - name: basic_credential_manager
