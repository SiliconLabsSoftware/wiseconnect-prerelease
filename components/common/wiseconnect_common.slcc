id: wiseconnect_common
package: wiseconnect_common
description: >
  Provides a library of commonly used components in the WiSeConnect SDK.
label: WiSeConnect Common Library
category: Common
quality: production
metadata:
  sbom:
    license: Zlib
component_root_path: ./components/common
provides:
- name: wiseconnect_common
- name: wiseconnect3_common
source:
- path: src/sl_si91x_common_flash.c
- path: src/sl_utility.c
- path: src/sli_utility.c
- path: src/sli_power_profile.c
include:
- path: inc
  file_list:
    - path: sl_additional_status.h
    - path: sl_application_profile_types.h
    - path: sl_cmsis_utility.h
    - path: sl_constants.h
    - path: sl_ieee802_types.h
    - path: sl_ip_types.h
    - path: sl_si91x_common_flash.h
    - path: sl_si91x_status.h
    - path: sl_utility.h
    - path: sli_constants.h
    - path: sli_power_profile.h
    - path: sli_types.h
    - path: sl_types.h
    - path: sli_types.h
    - path: sli_utility.h

requires:
- name: status
- name: sl_common
- name: slist
- name: sl_string
- name: atomic
- name: cmsis_core
- name: malloc_thread_safety
- name: sli_command_engine
- name: sli_buffer_manager
- name: log_none
  condition: ["device_si91x"]

toolchain_settings:
  - option: gcc_compiler_option
    value: -Wno-error=deprecated-declarations
  - option: llvm_compiler_option
    value: -Wno-error=deprecated-declarations
