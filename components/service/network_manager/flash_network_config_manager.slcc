id: flash_network_config_manager
package: wifi
description: >
  Flash Network Config Manager provides an API to manage network credentials and profiles stored via Common Token Manager
label: Flash Network Configuration Manager
category: Service|Network Management|Configuration
quality: production
metadata:
  sbom:
    license: MSLA
component_root_path: ./components/service/network_manager
provides:
- name: flash_network_config_manager
- name: network_config_manager
source:
- path: src/sli_net_credentials.c
- path: src/si91x/sl_net_credentials.c
  condition: ["sl_si91x_wireless"]
- path: src/sl_net_nvm_profiles.c
  condition: ["sl_si91x_wireless"]
define:
- name: SLI_NVM3_CONFIG_MANAGER
  condition: ["sl_si91x_wireless"]
- name: NVM3_LOCK_OVERRIDE
  condition: ["sl_si91x_wireless"]
requires:
- name: network_manager
- name: flash_credential_manager
- name: nvm3_lib
  condition: ["sl_si91x_wireless"]
- name: log_none
  condition: ["device_si91x"]
conflicts:
- name: basic_network_config_manager
