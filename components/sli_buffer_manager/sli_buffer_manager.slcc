id: sli_buffer_manager
label: sli Buffer Manager
package: wiseconnect_common
description: >
  This package provides buffer management
category: Buffer Manager
component_root_path: components/sli_buffer_manager
quality: production
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
source:
- path: src/sli_buffer_manager.c
include:
  - path: inc/si91x
    condition:
      - sl_si91x_wireless
    file_list:
      - path: sli_buffer_manager_config.h

  - path: inc/siwx3xx
    unless:
      - sl_si91x_wireless
    file_list:
      - path: sli_buffer_manager_config.h

  - path: inc
    file_list:
      - path: sli_buffer_manager.h
      - path: sli_buffer_manager_types.h
provides:
  - name: sli_buffer_manager
requires:
- name: mem_pool
- name: log_none
  condition: ["device_si91x"]